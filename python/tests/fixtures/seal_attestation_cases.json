{
  "_comment": "Shared by python/tests/test_seal_attestation.py and ts/tests/seal_attestation.test.ts so the two decoders are held to one table. Wire values are raw enum integers (SealAttestationAvailability, SealReason, CollectiveVerdict) so an unknown value can be expressed. 'attestation': null means the field is absent. 'expect': null means the decoder returns None/undefined; 'expect': 'raise' means UnknownCollectiveVerdictError.",
  "cases": [
    {"name": "absent (runtime < 0.61.0)", "attestation": null, "expect": null},
    {"name": "NOT_RECORDED, the 0.61.x norm", "attestation": {"availability": 2, "seal_reason": 0, "collective": null},
     "expect": {"availability": "NOT_RECORDED", "seal_reason": null, "collective": null}},
    {"name": "KEY_UNAVAILABLE", "attestation": {"availability": 3, "seal_reason": 0, "collective": null},
     "expect": {"availability": "KEY_UNAVAILABLE", "seal_reason": null, "collective": null}},
    {"name": "ARCHIVED", "attestation": {"availability": 4, "seal_reason": 0, "collective": null},
     "expect": {"availability": "ARCHIVED", "seal_reason": null, "collective": null}},
    {"name": "CLEARANCE_DENIED", "attestation": {"availability": 5, "seal_reason": 0, "collective": null},
     "expect": {"availability": "CLEARANCE_DENIED", "seal_reason": null, "collective": null}},
    {"name": "UNAVAILABLE", "attestation": {"availability": 6, "seal_reason": 0, "collective": null},
     "expect": {"availability": "UNAVAILABLE", "seal_reason": null, "collective": null}},
    {"name": "UNSPECIFIED availability reads UNRECOGNIZED", "attestation": {"availability": 0, "seal_reason": 0, "collective": null},
     "expect": {"availability": "UNRECOGNIZED", "seal_reason": null, "collective": null}},
    {"name": "unknown availability 99 reads UNRECOGNIZED", "attestation": {"availability": 99, "seal_reason": 0, "collective": null},
     "expect": {"availability": "UNRECOGNIZED", "seal_reason": null, "collective": null}},
    {"name": "NOT_RECORDED ignores a payload it carries", "attestation": {"availability": 2, "seal_reason": 1, "collective": {"verdict": 1, "approve_count": 2, "reject_count": 0, "abstain_count": 0, "declared_participant_count": 2, "stated_value_contradicted_tally": false, "effective_threshold": null}},
     "expect": {"availability": "NOT_RECORDED", "seal_reason": null, "collective": null}},
    {"name": "unknown availability ignores a payload it carries", "attestation": {"availability": 99, "seal_reason": 1, "collective": {"verdict": 99, "approve_count": 0, "reject_count": 0, "abstain_count": 0, "declared_participant_count": 0, "stated_value_contradicted_tally": false, "effective_threshold": null}},
     "expect": {"availability": "UNRECOGNIZED", "seal_reason": null, "collective": null}},
    {"name": "RECORDED + COMMIT + APPROVED quorum", "attestation": {"availability": 1, "seal_reason": 1, "collective": {"verdict": 1, "approve_count": 2, "reject_count": 1, "abstain_count": 0, "declared_participant_count": 3, "stated_value_contradicted_tally": false, "effective_threshold": 2}},
     "expect": {"availability": "RECORDED", "seal_reason": "COMMIT", "collective": {"verdict": "APPROVED", "approve_count": 2, "reject_count": 1, "abstain_count": 0, "declared_participant_count": 3, "stated_value_contradicted_tally": false, "effective_threshold": 2}}},
    {"name": "RECORDED + COMMIT + DECLINED, no threshold", "attestation": {"availability": 1, "seal_reason": 1, "collective": {"verdict": 2, "approve_count": 0, "reject_count": 2, "abstain_count": 1, "declared_participant_count": 3, "stated_value_contradicted_tally": true, "effective_threshold": null}},
     "expect": {"availability": "RECORDED", "seal_reason": "COMMIT", "collective": {"verdict": "DECLINED", "approve_count": 0, "reject_count": 2, "abstain_count": 1, "declared_participant_count": 3, "stated_value_contradicted_tally": true, "effective_threshold": null}}},
    {"name": "RECORDED + COMMIT with no collective is not an error", "attestation": {"availability": 1, "seal_reason": 1, "collective": null},
     "expect": {"availability": "RECORDED", "seal_reason": "COMMIT", "collective": null}},
    {"name": "RECORDED + CANCEL ignores a collective it carries", "attestation": {"availability": 1, "seal_reason": 2, "collective": {"verdict": 1, "approve_count": 1, "reject_count": 0, "abstain_count": 0, "declared_participant_count": 1, "stated_value_contradicted_tally": false, "effective_threshold": null}},
     "expect": {"availability": "RECORDED", "seal_reason": "CANCEL", "collective": null}},
    {"name": "RECORDED + EXPIRE_TTL", "attestation": {"availability": 1, "seal_reason": 3, "collective": null},
     "expect": {"availability": "RECORDED", "seal_reason": "EXPIRE_TTL", "collective": null}},
    {"name": "RECORDED + EXPIRE_SUSPEND_CAP", "attestation": {"availability": 1, "seal_reason": 4, "collective": null},
     "expect": {"availability": "RECORDED", "seal_reason": "EXPIRE_SUSPEND_CAP", "collective": null}},
    {"name": "RECORDED + UNSPECIFIED reason reads UNRECOGNIZED, collective ignored", "attestation": {"availability": 1, "seal_reason": 0, "collective": {"verdict": 1, "approve_count": 1, "reject_count": 0, "abstain_count": 0, "declared_participant_count": 1, "stated_value_contradicted_tally": false, "effective_threshold": null}},
     "expect": {"availability": "RECORDED", "seal_reason": "UNRECOGNIZED", "collective": null}},
    {"name": "RECORDED + unknown reason 99 reads UNRECOGNIZED", "attestation": {"availability": 1, "seal_reason": 99, "collective": null},
     "expect": {"availability": "RECORDED", "seal_reason": "UNRECOGNIZED", "collective": null}},
    {"name": "RECORDED + COMMIT + UNSPECIFIED verdict raises", "attestation": {"availability": 1, "seal_reason": 1, "collective": {"verdict": 0, "approve_count": 0, "reject_count": 0, "abstain_count": 0, "declared_participant_count": 0, "stated_value_contradicted_tally": false, "effective_threshold": null}},
     "expect": "raise"},
    {"name": "RECORDED + COMMIT + unknown verdict 99 raises", "attestation": {"availability": 1, "seal_reason": 1, "collective": {"verdict": 99, "approve_count": 0, "reject_count": 0, "abstain_count": 0, "declared_participant_count": 0, "stated_value_contradicted_tally": false, "effective_threshold": null}},
     "expect": "raise"}
  ]
}
